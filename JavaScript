    });
// Obtém o elemento de áudio
const audio = document.getElementById('audioNarracao');

function lerTexto() {
    // Se o áudio estiver pausado, ele toca
    audio.play();
}

function pararLeitura() {
    // Pausa o áudio e volta para o início
    audio.pause();
    audio.currentTime = 0;
}

function alterarVelocidade() {
    // Altera a velocidade de reprodução do arquivo de áudio gravado
    const vel = parseFloat(document.getElementById('velocidadeVoz').value);
    audio.playbackRate = vel;
}
// Função para controlar a reprodução individual por seção
function tocarAudio(idAudio) {
    // 1. Pausa e reseta todos os áudios da página
    const todosAudios = document.querySelectorAll('audio');
    todosAudios.forEach(audio => {
        if (audio.id !== idAudio) {
            audio.pause();
            audio.currentTime = 0;
        }
    });

    // 2. Seleciona o áudio atual
    const audioAtual = document.getElementById(idAudio);

    // 3. Alterna entre tocar e pausar
    if (audioAtual.paused) {
        audioAtual.play();
    } else {
        audioAtual.pause();
    }
}
});